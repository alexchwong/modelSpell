{
 "_comment": "Golden request bodies (spec §7.4). Default input is MSGS = [system 'sys', user 'task'], model 'm'. 'path' is relative to the endpoint host.",
 "G1": {"kind": "lmstudio", "args": {"temperature": 0.0, "max_tokens": 8192}, "stream": false, "path": "/v1/responses",
        "body": {"model": "m", "input": "MSGS", "temperature": 0.0, "max_output_tokens": 8192, "stream": false}},
 "G2": {"kind": "lmstudio", "args": {"reasoning": "high", "temperature": 0.0, "max_tokens": 8192}, "stream": true, "path": "/v1/responses",
        "body": {"model": "m", "input": "MSGS", "temperature": 0.0, "max_output_tokens": 8192, "stream": true, "reasoning": {"effort": "high"}}},
 "G3": {"kind": "lmstudio", "args": {"reasoning": "off", "temperature": 0.0, "max_tokens": 16384}, "stream": false, "path": "/api/v1/chat",
        "input": [{"role": "system", "content": "sys"}, {"role": "user", "content": "original"},
                  {"role": "assistant", "content": "bad output"}, {"role": "user", "content": "repair feedback"}],
        "body": {"model": "m", "input": "[USER]\noriginal\n\n[ASSISTANT]\nbad output\n\n[USER]\nrepair feedback",
                 "temperature": 0.0, "max_output_tokens": 16384, "reasoning": "off", "store": false, "stream": false,
                 "system_prompt": "sys"}},
 "G4": {"kind": "lmstudio", "args": {"reasoning": "off"}, "stream": false, "path": "/api/v1/chat",
        "body": {"model": "m", "input": "task", "reasoning": "off", "store": false, "stream": false, "system_prompt": "sys"}},
 "G5": {"kind": "openrouter", "args": {"reasoning": "off", "temperature": 0.2, "max_tokens": 4096,
                                       "provider": {"order": ["deepinfra"], "allow_fallbacks": false}}, "stream": true,
        "path": "/v1/chat/completions",
        "body": {"model": "m", "messages": "MSGS", "temperature": 0.2, "max_tokens": 4096, "stream": true,
                 "provider": {"order": ["deepinfra"], "allow_fallbacks": false}, "reasoning": {"effort": "none"}}},
 "G6": {"kind": "openrouter", "args": {}, "stream": false, "path": "/v1/chat/completions",
        "body": {"model": "m", "messages": "MSGS", "stream": false}},
 "G7": {"kind": "openai_compat", "args": {"temperature": 0.0, "max_tokens": 512}, "stream": false, "path": "/v1/chat/completions",
        "body": {"model": "m", "messages": "MSGS", "temperature": 0.0, "max_tokens": 512, "stream": false}},
 "G8": {"kind": "openai_compat", "args": {"temperature": 0.0, "max_tokens": 512,
                                          "extra": {"chat_template_kwargs": {"enable_thinking": false}, "max_tokens": 256}},
        "stream": false, "path": "/v1/chat/completions",
        "body": {"model": "m", "messages": "MSGS", "temperature": 0.0, "max_tokens": 256, "stream": false,
                 "chat_template_kwargs": {"enable_thinking": false}}}
}
